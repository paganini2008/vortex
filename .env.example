# run-docker.sh settings: how the cluster is deployed on Docker.
#
#   cp .env.example .env     at the repository root; .env is not committed
#
# The nodes' own settings are in backend/tsdb-service/.env, which run-docker.sh hands to every
# node; the web UI's are in frontend/tsdb-web/.env.
#
# Precedence: a variable already set in the environment, then .env, then the default shown.
# One NAME=value per line, no quotes, no spaces around "=". Lines starting with # are ignored:
# a commented-out setting takes its default.

# Nodes to start, and whether to start the web UI and a Redis of its own
VORTEX_NODES=3
VORTEX_WEB=true
VORTEX_REDIS=true
# The gateway (web UI, API, Swagger UI) and the Traefik dashboard
VORTEX_GATEWAY_PORT=9080
VORTEX_DASHBOARD_PORT=9081
# Each node's HTTP port is also published here, on a free port in this range
VORTEX_NODE_PORT_RANGE=50000-60000
# The nodes' private subnet, e.g. 10.240.0; blank to pick a free one
VORTEX_SUBNET_PREFIX=
VORTEX_TRAEFIK_IMAGE=traefik:v3
VORTEX_REDIS_IMAGE=redis:7-alpine

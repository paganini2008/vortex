# Vortex TSDB web UI settings.
#
#   cp .env.example .env     in frontend/tsdb-web; .env is not committed
#
# Next.js loads this file itself. On Docker the UI sits behind the gateway and needs neither.
#
# Precedence: a variable already set in the environment, then .env, then the default shown.
# One NAME=value per line, no quotes, no spaces around "=". Lines starting with # are ignored:
# a commented-out setting takes its default.

# Where the UI's server sends /tsd/* when the UI is not behind the gateway, comma separated:
# the gateway, or nodes directly (each node logs its address at start-up)
VORTEX_API_URLS=http://localhost:9080
# Port of the UI's dev server (npm run dev)
VORTEX_WEB_PORT=3000

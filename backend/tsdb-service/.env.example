# Vortex TSDB node settings.
#
#   cp .env.example .env     in backend/tsdb-service; .env is not committed
#
# Read from the working directory (run the node from here, or set VORTEX_ENV_FILE). On Docker,
# run-docker.sh hands every setting here to each node; it sets the port, peers, advertised
# address and data directory itself, and VORTEX_REDIS_HOST when it starts its own Redis.
#
# Precedence: a variable already set in the environment, then .env, then the default shown.
# One NAME=value per line, no quotes, no spaces around "=". Lines starting with # are ignored:
# a commented-out setting takes its default.

# HTTP port. Unset: a free port in VORTEX_PORT_RANGE, logged at start-up. Docker uses 30080
# VORTEX_SERVER_PORT=30080
VORTEX_PORT_RANGE=50000-60000

# Cluster name: the only isolation between environments
VORTEX_CLUSTER_NAME=vortex-tsd-cluster
# Where nodes look for each other, comma separated. 127.0.0.1 is enough on one machine
VORTEX_CLUSTER_PEERS=127.0.0.1
# The cluster port, the same on every node
VORTEX_CLUSTER_PORT=22000
# The address other nodes reach this one at; blank to detect it. Set it in containers
VORTEX_ADVERTISE_HOST=

# Bucket width in minutes (must divide 60), and how many buckets /tsd/retrieve returns
VORTEX_SPAN_MINUTES=1
VORTEX_DISPLAY_SIZE=60
# How long buckets are kept: 30m, 24h, 7d...
VORTEX_RETENTION=24h
# Zone for windows when a request names none. The web UI always sends the browser's
VORTEX_TIME_ZONE=UTC
# How often each node writes its copy to disk, besides at shutdown; 0 for shutdown only
VORTEX_SNAPSHOT_INTERVAL=5m
# Where that copy is written. Unset: ~/.vortex-tsdb; /data in Docker
# VORTEX_DATA_DIR=/var/lib/vortex
# How often a node refreshes a series' last-seen time in the catalog
VORTEX_CATALOG_TOUCH_INTERVAL=30s
# Origins allowed to call /tsd/** from a browser directly (the web UI proxies, so needs none)
VORTEX_CORS_ORIGINS=http://localhost:3000

# Keys each node keeps in memory. Beyond it the least recently used move to Redis when
# VORTEX_REDIS_HOST is set, and are DELETED when it is not
VORTEX_CACHE_MAX_KEYS=10000

# Redis for the overflow. Blank host: no overflow. run-docker.sh starts its own Redis unless a
# host is given here
VORTEX_REDIS_HOST=
VORTEX_REDIS_PORT=6379
VORTEX_REDIS_PASSWORD=
VORTEX_REDIS_DATABASE=0
VORTEX_REDIS_KEY_PREFIX=vortex:cache:
